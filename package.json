{
  "name": "podium",
  "productName": "Podium",
  "version": "0.1.0",
  "description": "Desktop-App für Slidev-Präsentationen: bearbeiten wie in PowerPoint, Dateien bleiben Markdown.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:e2e": "xvfb-run -a -s \"-screen 0 1600x1000x24\" playwright test -c tests/e2e/app/playwright.config.ts",
    "test:bridge": "playwright test -c tests/e2e/bridge/playwright.config.ts",
    "seed": "node scripts/prepare-seed.mjs",
    "dist": "node scripts/prepare-npm.mjs && electron-vite build && electron-builder",
    "dist:dir": "node scripts/prepare-npm.mjs && electron-vite build && electron-builder --dir"
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@lucide/vue": "^1.72.0",
    "@playwright/test": "^1.65.0",
    "@slidev/parser": "^53.1.0",
    "@slidev/types": "^53.1.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^6.0.11",
    "chokidar": "^6.0.0",
    "codemirror": "^6.0.2",
    "electron": "^45.3.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "fflate": "^0.8.3",
    "get-port-please": "^3.2.0",
    "markdown-it": "^15.0.3",
    "npm": "^12.2.2",
    "pinia": "^4.1.0",
    "playwright": "^1.65.0",
    "sortablejs": "^1.15.7",
    "typescript": "^6.0.3",
    "uqr": "^0.1.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14",
    "yaml": "^2.9.1"
  },
  "author": {
    "name": "Podium contributors"
  },
  "homepage": "https://sli.dev",
  "license": "UNLICENSED",
  "build": {
    "appId": "dev.podium.app",
    "productName": "Podium",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "launcher",
        "to": "launcher",
        "filter": [
          "launcher.mjs",
          "bridge-client.js"
        ]
      },
      {
        "from": "templates",
        "to": "templates"
      },
      {
        "from": "build/npm.zip",
        "to": "npm.zip"
      },
      {
        "from": "build/runtime-seed",
        "to": "runtime-seed"
      }
    ],
    "fileAssociations": [
      {
        "ext": "podium",
        "name": "Podium-Präsentation",
        "role": "Editor"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "maintainer": "Podium contributors <podium@localhost>",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false
    },
    "win": {
      "target": [
        "nsis"
      ]
    }
  },
  "desktopName": "podium.desktop"
}
