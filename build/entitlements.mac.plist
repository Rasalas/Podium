<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Chromium's JavaScript engine writes and runs machine code. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- Slidev runs inside the app (Electron as Node) and loads native modules that npm
       downloaded: Vite's bundler, the file watcher. They are not signed with our certificate. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Slidev's presenter view: camera picture on the slides, recording the talk. -->
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
